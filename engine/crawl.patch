+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+// Bridge to the browser: output goes to JS, input comes from a JS queue.
+EM_JS(void, wasm_post_output, (const char* s, int len), {
+  self.crawlOut(UTF8ToString(s, len));
+});
+EM_JS(int, wasm_input_pending, (), {
+  return self.crawlInputQueue.length;
+});
+EM_JS(char*, wasm_input_pop, (), {
+  var s = self.crawlInputQueue.shift();
+  if (s === undefined) return 0;
+  var n = lengthBytesUTF8(s) + 1;
+  var p = _malloc(n);
+  stringToUTF8(s, p, n);
+  return p;
+});
+#endif
 
