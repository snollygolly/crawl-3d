{
  "name": "crawl3d",
  "version": "0.1.0",
  "private": true,
  "description": "Dungeon Crawl Stone Soup in the browser (wasm) with a three.js 3D view",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "start": "npm run build && node scripts/serve.mjs",
    "build": "python3 scripts/assemble.py",
    "preview": "node scripts/serve.mjs",
    "lint": "./node_modules/.bin/eslint .",
    "test:unit": "node --test \"test/**/*.test.js\"",
    "pretest:coverage": "node -e \"require('fs').mkdirSync('coverage', {recursive: true})\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=config.mjs --test-coverage-include=\"scripts/lib/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.js\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "./node_modules/.bin/playwright test",
    "test": "npm run lint && npm run test:unit",
    "fetch-engine": "bash scripts/fetch-engine.sh",
    "build-engine": "bash scripts/build-engine.sh",
    "build-engine:docker": "bash scripts/build-engine-docker.sh",
    "upload-engine": "node scripts/upload-engine.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.0.0"
  }
}
